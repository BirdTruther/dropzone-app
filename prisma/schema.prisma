generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  avatar        String?
  isSiteAdmin   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Notification preferences — all default true (opt-out model)
  notifyPushNewDrop     Boolean @default(true)
  notifyPushReaction    Boolean @default(true)
  notifyPushComment     Boolean @default(true)
  notifyPushMention     Boolean @default(true)
  notifyInAppNewDrop    Boolean @default(true)
  notifyInAppReaction   Boolean @default(true)
  notifyInAppComment    Boolean @default(true)
  notifyInAppMention    Boolean @default(true)

  memberships       GroupMember[]
  posts             Post[]
  reactions         Reaction[]
  comments          Comment[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  emoji       String    @default("🔗")
  inviteCode  String    @unique @default(cuid())
  openInvite  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  members     GroupMember[]
  posts       Post[]
}

model GroupMember {
  id        String   @id @default(cuid())
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String

  @@unique([userId, groupId])
}

model Post {
  id          String    @id @default(cuid())
  url         String    @default("")
  title       String?
  description String?
  image       String?
  siteName    String?
  note        String?
  uploadUrl   String?
  uploadType  String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  author      User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String

  reactions   Reaction[]
  shareTokens ShareToken[]
  comments    Comment[]
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@unique([userId, postId, emoji])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
}

model ShareToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  message     String
  link        String?
  actorName   String?
  actorAvatar String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
