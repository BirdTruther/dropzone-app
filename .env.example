# Database
DATABASE_URL="postgresql://dropzone:dropzone_pass@db:5432/dropzone"

# NextAuth
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="production"

# Push Notifications (VAPID)
# Generate your own keys by running: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY_HERE"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY_HERE"
VAPID_MAILTO="mailto:you@example.com"
