# Database
DATABASE_URL="postgresql://dropzone:CHANGE_ME_DB_PASSWORD@db:5432/dropzone"

# NextAuth
NEXTAUTH_URL="http://localhost:8742"
NEXTAUTH_SECRET="your-secret-here"

# Internal API (secret for internal calls — run `openssl rand -base64 32`)
INTERNAL_API_SECRET="your-internal-api-secret"

# Site hostname (bare host, no protocol — used for Twitch embeds)
NEXT_PUBLIC_SITE_HOSTNAME="your.domain.here"

# Web Push Notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:you@example.com"
